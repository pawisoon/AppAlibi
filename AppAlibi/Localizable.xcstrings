    "Every app has to account for itself." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda aplikacja musi się rozliczyć."
          }
        }
      }
    },
    "Every time" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za każdym razem"
          }
        }
      }
    },
    "Every time an app is allowed to install software or make other changes that need an admin password." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za każdym razem, gdy aplikacja dostaje zgodę na instalację oprogramowania lub inne zmiany wymagające hasła administratora."
          }
        }
      }
    },
    "Everything stays on this Mac and there is no account. AppAlibi reads the macOS log and never sends it anywhere." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko zostaje na tym Macu i nie ma konta. AppAlibi odczytuje dziennik macOS i nigdzie go nie wysyła."
          }
        }
      }
    },

            "state" : "translated",
            "value" : "Aplikacje sięgające po chronione dane: %lld, odmowy: %lld"
          }
        }
      }
    },
    "Apps you installed or opened, or the system services that run in the background." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje zainstalowane lub otwarte na tym Macu albo usługi systemowe działające w tle."
          }
        }
      }
    },

    },
    "An eye in the menu bar that fills while a sensor is in use. No Dock icon." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oko na pasku menu, które wypełnia się, gdy czujnik jest w użyciu. Bez ikony w Docku."
          }
        }
      }
    },

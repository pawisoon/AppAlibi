            "value" : "Historia"
          }
        }
      }
    },
    "History older than that is deleted now, and from then on as it ages. This cannot be undone." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starsza historia zostanie usunięta teraz, a potem na bieżąco, gdy się zestarzeje. Tego nie można cofnąć."
          }
        }
      }
    },
    "History…" : {

    "AppAlibi" : {
      "shouldTranslate" : false
    },
    "AppAlibi Admin Rights" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi – uprawnienia administratora"
          }
        }
      }
    },
    "AppAlibi History" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia AppAlibi"
          }
        }
      }
    },
    "AppAlibi Permissions" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi – uprawnienia"
          }
        }
      }
    },
    "AppAlibi Sensors" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi – czujniki"
          }
        }
      }
    },
    "AppAlibi can tell you when an app turns on your camera, microphone or screen for the first time, what used them while your Mac was locked, and sum up each day at %@. Change any of these, or add a weekly summary, in Settings." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi może dać ci znać, gdy aplikacja po raz pierwszy włączy kamerę, mikrofon lub ekran, pokazać, co z nich korzystało, gdy Mac był zablokowany, i podsumować każdy dzień o %@. Każdą z tych opcji możesz zmienić, a podsumowanie tygodniowe dodać, w Ustawieniach."
          }
        }
      }
    },
    "AppAlibi reads the same macOS log entries that light up the privacy dots. The history stays in a database on this Mac. There is no account and nothing is uploaded." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi odczytuje te same wpisy dziennika macOS, które zapalają kropki prywatności. Historia zostaje w bazie danych na tym Macu. Nie ma konta i nic nie jest wysyłane."
          }
        }
      }
    },
    "AppAlibi records while it runs, and catches up on the last few days of the log when it starts. Closing the window does not stop it. Quitting does." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi zapisuje, dopóki działa, a po uruchomieniu nadrabia ostatnie kilka dni dziennika. Zamknięcie okna go nie zatrzymuje. Zakończenie działania – tak."
          }
        }
      }
    },
    "AppAlibi, sensor in use" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppAlibi, czujnik w użyciu"
          }
        }
      }
    },
    "Apple background services, such as screenshots taken by the system." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługi Apple działające w tle, np. zrzuty ekranu wykonywane przez system."
          }
        }
      }
    },
    "Apps" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje"
          }
        }
      }
    },
    "Apps and system services are kept apart, so the background noise of macOS stays out of the way." : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje i usługi systemowe są rozdzielone, więc szum tła macOS nie przeszkadza."
          }
        }
      }
    },
    "Apps reaching for protected data: %lld" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacje sięgające po chronione dane: %lld"
          }
        }
      }
    },
    "Apps reaching for protected data: %lld, checks denied: %lld" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
